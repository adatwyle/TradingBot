# --- Python ------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
venv/

# --- Secrets (jamais dans le repo — vivent dans C:\db\tradingBot\secrets\) ---
*.secret
*token*.txt
*key*.txt
.env
.env.*
!.env.example

# --- Datas lourdes / régénérables (D4 — restent locales) ----
*.parquet
*.pkl
*.pickle
datasets/
bars_cache/
data/cache/

# --- Bases de données (vivent dans C:\db\tradingBot\) -------
*.db
*.db-wal
*.db-shm

# --- Logs et runtime ----------------------------------------
logs/
*.log
.stop
*.lock

# --- OS / IDE -----------------------------------------------
Thumbs.db
.DS_Store
.claude/settings.local.json

# --- Backup GitHub (T8, SPEC_backup-github) -----------------
# db-backup/ est le MIROIR versionné des états légers : les patterns racine
# (logs/ notamment) ne doivent pas le trouer. Ré-inclusion CIBLÉE des seuls
# noms de l'allowlist BK-1 — token/key/secret, *.db, *.parquet, *.log restent
# ignorés MÊME sous db-backup/ (défense en profondeur, BK-2).
!db-backup/**/
!db-backup/**/journal.csv
!db-backup/**/status.json
!db-backup/**/state.json
!db-backup/**/config.json
!db-backup/**/events.csv
!db-backup/robinbot-panel.txt
!db-backup/tbot-panel.txt
